{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*/*" }, { "url": "https://*:*/*" }]
    },
    "fs:default",
    "fs:allow-read-text-file",
    "dialog:default",
    "dialog:allow-open",
    "store:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
