{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PandoraIPTV",
  "version": "0.1.0",
  "identifier": "com.ahmed.iptvplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PandoraIPTV",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; media-src * blob: https: http:; font-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost https://* http://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "PandoraIPTV",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/ahmed/pandoraiptv/releases/latest/download/latest.json"
      ]
    }
  }
}